    "This will delete all word records. This action cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete all word records. This action cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての単語記録が削除されます。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 단어 기록이 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除所有单词记录。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將刪除所有單字記錄。此操作無法撤銷。"
          }
        }
      }
    },
    "This will delete mastered words older than %lld days and remove excess records beyond %lld.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete mastered words older than %lld days and remove excess records beyond %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日以上前の習得済み単語を削除し、%lld 件を超える記録を削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일 이상 지난 습득한 단어를 삭제하고 %lld개를 초과하는 기록을 제거합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除 %lld 天前的已掌握单词，并移除超过 %lld 条的多余记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將刪除 %lld 天前的已掌握單字，並移除超過 %lld 條的多餘記錄。"
          }
        }
      }
