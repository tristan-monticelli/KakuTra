    "Move cursor over text or press Esc to stop.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the cursor over text or press Esc to stop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le curseur sur du texte, ou appuyez sur Échap pour arrêter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストの上にカーソルを移動するか、Escキーを押して停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 위로 커서를 옮기거나 Esc 키를 눌러 중지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将光标移到文本上，或按 Esc 停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將游標移到文字上，或按 Esc 停止。"
          }
        }
      }
    },
    "Optional in Direct: reads an existing text selection for one-press sentence translation; OCR is used when unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional in Direct: reads an existing text selection for one-press sentence translation; OCR is used when unavailable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif dans Direct : lit une sélection existante pour la traduire comme phrase lors d’un appui simple ; sinon, l’OCR prend le relais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct では任意です。1 回押したときに既存の選択範囲を読み取って文として翻訳し、利用できない場合は OCR に切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct에서 선택 사항입니다. 한 번 눌렀을 때 기존 선택 영역을 문장으로 번역하고, 사용할 수 없으면 OCR로 전환합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Direct 版本中为可选：单击时读取已有选区并作为句子翻译；选区不可用时改用 OCR。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Direct 版本中為選用：單按時讀取現有選取範圍並作為句子翻譯；無法使用時改用 OCR。"
          }
        }
      }
    },
